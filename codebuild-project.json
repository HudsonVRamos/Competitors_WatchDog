{
  "name": "price-watchdog-build",
  "source": {
    "type": "GITHUB",
    "location": "https://github.com/HudsonVRamos/Competitors_WatchDog.git",
    "buildspec": "buildspec.yml"
  },
  "artifacts": {
    "type": "NO_ARTIFACTS"
  },
  "environment": {
    "type": "LINUX_CONTAINER",
    "image": "aws/codebuild/standard:7.0",
    "computeType": "BUILD_GENERAL1_MEDIUM",
    "privilegedMode": true,
    "environmentVariables": [
      {
        "name": "AWS_DEFAULT_REGION",
        "value": "us-east-1"
      },
      {
        "name": "AWS_ACCOUNT_ID",
        "value": "761018874615"
      }
    ]
  },
  "serviceRole": "arn:aws:iam::761018874615:role/price-watchdog-codebuild-role",
  "logsConfig": {
    "cloudWatchLogs": {
      "status": "ENABLED",
      "groupName": "/codebuild/price-watchdog"
    }
  }
}
